# Copy to .env (never commit .env).
DB_URL=jdbc:mysql://localhost:3306/campushub?useSSL=false&serverTimezone=UTC
DB_USER=campus
DB_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-32-random-chars-xxxxxxxxxxxxxxxx
OTP_SECRET=replace-with-another-random-secret-xxxxxxxxxxxxxxx
PAYMENT_WEBHOOK_SECRET=replace-with-gateway-shared-secret
CORS_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-long-password
# Optional: SMTP (without it, emails are logged in dev)
MAIL_HOST=
MAIL_USER=
MAIL_PASSWORD=
# Private S3-compatible bucket (AWS S3 / Cloudflare R2 / MinIO)
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
# SMS for sign-up codes. Leave provider as console for development.
# To send real texts set app.sms.provider=twilio (in application-local.yml) and fill these:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
